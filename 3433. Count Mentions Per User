import java.util.*;

class Solution {
    public int[] countMentions(int numberOfUsers, List<List<String>> events) {
        List<List<Integer>> store = new ArrayList<>();
        for (int i = 0; i < numberOfUsers; i++) {
            List<Integer> al = new ArrayList<>();
            al.add(1);
            al.add(0);
            store.add(al);
        }
        int message[] = new int[numberOfUsers];
        events.sort((a, b) -> {
        int timeComparison = Integer.parseInt(a.get(1)) - Integer.parseInt(b.get(1));
        if (timeComparison == 0) {
            if (a.get(0).equals("OFFLINE") && b.get(0).equals("MESSAGE")) {
                return -1;
            } else if (a.get(0).equals("MESSAGE") && b.get(0).equals("OFFLINE")) {
                return 1;
            }
            return 0; 
        }
        return timeComparison;
});


        for (List<String> al : events) {
            if (al.get(0).equals("MESSAGE")) {
                String thirdPart = al.get(2);
                String arrLen[] = thirdPart.split(" ");
                if (arrLen.length == 1) {
                    if (arrLen[0].equals("ALL")) {
                        for (int i = 0; i < numberOfUsers; i++) {
                            message[i]++;
                        }
                    } else if (arrLen[0].equals("HERE")) {
                        int currTimeStamp = Integer.parseInt(al.get(1));
                        for (int i = 0; i < store.size(); i++) {
                            List<Integer> ss = store.get(i);
                            if (ss.get(0) == 1) {
                                message[i]++;
                            } else {
                                if (currTimeStamp >= ss.get(1) + 60) {
                                    message[i]++;
                                    ss.set(0, 1);
                                    ss.set(1, currTimeStamp);
                                }
                            }
                        }
                    } else if (arrLen[0].startsWith("id")) {
                        int idx = Integer.parseInt(arrLen[0].substring(2));
                        if (idx >= 0 && idx < numberOfUsers) {
                            message[idx]++;
                        }
                    }
                } else {
                    for (String str : arrLen) {
                        if (str.startsWith("id")) {
                            int idx = Integer.parseInt(str.substring(2));
                            if (idx >= 0 && idx < numberOfUsers) {
                                message[idx]++;
                            }
                        }
                    }
                }

            } else if (al.get(0).equals("OFFLINE")) {
                int idx = Integer.parseInt(al.get(2));
                if (idx >= 0 && idx < numberOfUsers) {
                    List<Integer> ss = store.get(idx);
                    int offlineTime = Integer.parseInt(al.get(1));
                    ss.set(0, 0);
                    ss.set(1, offlineTime);
                    store.set(idx,ss);
                }
            }
        }

        return message;
    }
}
