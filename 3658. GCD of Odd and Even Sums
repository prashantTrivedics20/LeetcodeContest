class Solution {
    public int gcd(int a, int b)
    {
        while(a%b!=0)
        {
            int temp=a%b;
            a=b;
            b=temp;
        }
        return b;
    }
    public int gcdOfOddEvenSums(int n) {

        int oddSum=n*n;
        int evenSum =n*(n+1);

        return gcd(oddSum,evenSum);
        
    }
}
