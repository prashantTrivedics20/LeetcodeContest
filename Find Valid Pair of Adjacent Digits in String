class Solution {
    public String findValidPair(String s) {
        int n=s.length();
        int count[]=new int[10];
        for(int i=0;i<n;i++)
            {
                int num = s.charAt(i)-'0';
                count[num]++;
            }
        for(int i=0;i<n-1;i++)
            {
                int a=s.charAt(i)-'0';
                int b=s.charAt(i+1)-'0';
                if(count[a]==a&&count[b]==b&&a!=b)
                {
                    return ""+a+b;
                }
            }
        return "";
    }
}
