
class Solution {
    public static int helper(int[] nums, int k) {
        int freqOfK = 0;
        HashMap<Integer, Integer> map = new HashMap<>();
        for (int i : nums) {
            map.put(i, map.getOrDefault(i, 0) + 1);
        }
        
        if (map.containsKey(k)) {
            freqOfK += map.get(k);
        }
        
        int max = 0;
        
        for (int v = 1; v <= 50; v++) {
            if (v == k) continue;            
            int preSum = 0;
            int temp_max = 0;
            for (int num : nums) {
                if (num == v) {
                    preSum += 1;
                } else if (num == k) {
                    preSum -= 1;
                }

                if (preSum < 0) {
                   preSum = 0;
                }

                if (preSum > temp_max) {
                    temp_max = preSum;
                }
            }

            if (temp_max > max) {
                max = temp_max;
            }
        }
        return  freqOfK + max;
    }

    public int maxFrequency(int[] nums, int k) {
        return helper(nums, k);
    }
}
