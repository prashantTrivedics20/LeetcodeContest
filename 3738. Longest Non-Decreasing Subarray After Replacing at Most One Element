class Solution {

    public int longestSubarray(int[] nums) {
        int n = nums.length;
        int[] temp = nums; 
        
        if (n <= 1) return n;

        int[] left = new int[n];
        left[0] = 1;
        int maxLen = 1;
        for (int i = 1; i < n; i++) {
            if (temp[i] >= temp[i - 1]) {
                left[i] = left[i - 1] + 1;
            } else {
                left[i] = 1;
            }
            maxLen = Math.max(maxLen, left[i]);
        }
        int[] right = new int[n];
        right[n - 1] = 1;
        for (int i = n - 2; i >= 0; i--) {
            if (temp[i] <= temp[i + 1]) {
                right[i] = right[i + 1] + 1;
            } else {
                right[i] = 1;
            }
        }
 
        for (int i = 0; i < n; i++) {

            int L = (i > 0) ? left[i - 1] : 0;
            int R = (i < n - 1) ? right[i + 1] : 0;
            if (i > 0 && i < n - 1) {
                long prev = temp[i - 1];
                long next =  temp[i + 1];
                if (prev <= next) {
                    int currentLen = L + 1 + R;
                    maxLen = Math.max(maxLen, currentLen);
                }
                maxLen = Math.max(maxLen, L + 1);
                maxLen = Math.max(maxLen, R + 1);
                
            } else if (i == 0) {
              
                maxLen = Math.max(maxLen, 1 + R);
                
            } else if (i == n - 1) {
                maxLen = Math.max(maxLen, L + 1);
            }
        }
        
        return maxLen;
    }
}
