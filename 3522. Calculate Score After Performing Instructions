class Solution {
    public long calculateScore(String[] instructions, int[] values) {
        int n= instructions.length;
        long ans =0;
        boolean visited [] =new boolean[n];
        int i=0;
        while(i<n&&i>=0)
        {
            if(visited[i]==true)
            {
                break;
            }
            if(instructions[i].equals("add"))
            {
                visited[i]=true;
                ans+=values[i];
                i+=1;
            }
            else if(instructions[i].equals("jump"))
            {
                visited[i]=true;
                i+=values[i];
            }
            
        }
        return ans;
    }
}
